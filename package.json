{
  "name": "enmory-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=9999 --host --mode web",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.tsx\"",
    "deploy:web": "npm run format && npm run build:web && firebase deploy",
    "build:web": "tsc -b && env-cmd -f .env.web vite build --mode web",
    "build:ext": "tsc -b && env-cmd -f .env.ext vite build --mode ext",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ckeditor/ckeditor5-react": "^9.4.0",
    "@hookform/resolvers": "^3.9.1",
    "@react-oauth/google": "^0.12.1",
    "@reduxjs/toolkit": "^2.3.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-devtools": "^5.91.2",
    "antd": "^5.29.3",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "ckeditor5": "^43.3.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "env-cmd": "^10.1.0",
    "firebase": "^10.8.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "openai": "^6.44.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.27.0",
    "redux-persist": "^6.0.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@tanstack/eslint-plugin-query": "^5.91.3",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.8.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.11.0",
    "i": "^0.3.7",
    "npm": "^10.9.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "sass": "^1.97.3",
    "sass-embedded": "^1.80.4",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9"
  }
}
