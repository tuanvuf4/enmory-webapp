{
  "name": "Enmory",
  "version": "1.0",
  "description": "Learn English the way you like!",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "declarativeContent",
    "contextMenus",
    "identity",
    "identity.email"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "logo192.png",
    "32": "logo192.png",
    "48": "logo192.png",
    "128": "logo192.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "logo192.png"
  }
}
